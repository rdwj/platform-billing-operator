# Build ledger-svc binary
FROM golang:1.26 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ cmd/
COPY api/ api/
COPY gen/ gen/
COPY internal/ internal/
RUN CGO_ENABLED=0 go build -o ledger-svc ./cmd/ledger-svc/

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/ledger-svc .
COPY --chmod=644 migrations/ /migrations/
USER 65532:65532
ENTRYPOINT ["/ledger-svc"]
