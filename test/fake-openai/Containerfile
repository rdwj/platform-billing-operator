# Build fake-openai binary
FROM golang:1.26 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN go mod download
COPY test/fake-openai/ test/fake-openai/
RUN CGO_ENABLED=0 go build -o fake-openai ./test/fake-openai/

FROM gcr.io/distroless/static:nonroot
WORKDIR /
COPY --from=builder /workspace/fake-openai .
USER 65532:65532
ENTRYPOINT ["/fake-openai"]
